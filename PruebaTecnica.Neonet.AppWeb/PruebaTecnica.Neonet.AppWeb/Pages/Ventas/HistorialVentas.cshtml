@page
@model PruebaTecnica.Neonet.AppWeb.Pages.Ventas.HistorialVentasModel
@{
    ViewData["Title"] = "Historial de ventas";
}

<div class="container mt-4">
    <h2>Historial de ventas</h2>
    <hr />
    <form method="get">

        <div class="row mb-4">
            <div class="col-md-8">
                <label class="form-label">Cliente</label>
                <select asp-for="ClienteId" class="form-select">
                    <option value="">Seleccione un cliente</option>
                    @foreach (var cliente in Model.Clientes)
                    {
                        <option value="@cliente.id">
                            @cliente.nombre
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <button type="submit"
                        class="btn btn-primary">
                    Consultar
                </button>
            </div>
        </div>
    </form>
    @if (Model.ClienteId.HasValue)
    {
        <table class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>Venta</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var venta in Model.Ventas)
                {
                    <tr>
                        <td>@venta.id</td>

                        <td>
                            @venta.fecha.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            Q @venta.total.ToString("N2")
                        </td>

                        <td>
                            <a class="btn btn-sm btn-secondary"
                               asp-page="/Ventas/HistorialVentas"
                               asp-route-ClienteId="@Model.ClienteId"
                               asp-route-VentaId="@venta.id">
                                Ver detalle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.VentaId.HasValue && Model.Detalles.Any())
        {
            <hr />

            <h4>Detalle de venta #@Model.VentaId</h4>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Producto Id</th>
                        <th>Cantidad</th>
                        <th>Precio unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var detalle in Model.Detalles)
                    {
                        <tr>
                            <td>@detalle.productoId</td>
                            <td>@detalle.cantidad</td>
                            <td>Q @detalle.precioUnitario.ToString("N2")</td>
                            <td>
                                Q @((detalle.cantidad * detalle.precioUnitario).ToString("N2"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>
